{% extends template('widget') %}

{% define data = {
    isActivePage: _widget.isActivePage,
    isVisible: _widget.isVisible,
} %}

{% block body %}
    {% if data.isVisible %}
        <li class="menu__item {{ data.isActivePage ? 'menu__item--active' : '' }}">
            <a href="{{ url('customer/connected-apps') }}" data-qa="agentic-commerce-connected-apps">{{ 'agentic_commerce.apps.title' | trans }}</a>
        </li>
    {% endif %}
{% endblock %}
